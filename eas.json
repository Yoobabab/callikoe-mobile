{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EAS_BUILD_PROFILE": "dev" }
    },
    "apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "EAS_BUILD_PROFILE": "apk" }
    }
  }
}
